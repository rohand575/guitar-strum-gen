# ====================
# Data Files (Large)
# ====================
# Keep raw and processed folders but ignore large data files
data/raw/*.wav
data/raw/*.mp3
data/raw/*.flac
data/raw/*.mid
data/raw/*.midi
*.zip
*.tar.gz
*.rar

# Do NOT ignore JSONL files (our dataset format)
# !data/processed/*.jsonl

# ====================
# Model Checkpoints
# ====================
# Ignore large model files
*.pt
*.pth
*.h5
*.ckpt
checkpoints/*.pt
checkpoints/*.pth
models/*.bin

# Keep configs
!configs/*.yaml
!configs/*.json

# ====================
# Outputs (Generated)
# ====================
# Ignore generated outputs but keep the folder
outputs/*
!outputs/.gitkeep

